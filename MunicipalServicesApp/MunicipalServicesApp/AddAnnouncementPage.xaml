<Page x:Class="MunicipalServicesApp.AddAnnouncementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib"
      Title="Add Announcement"
      Background="{StaticResource PageBackgroundBrush}">

    <Grid Margin="28" Width="720">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📢 Add Announcement"
                   Style="{StaticResource PageTitleStyle}"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,12"/>

        <Border Grid.Row="1" Background="White" Padding="20" CornerRadius="6" BorderBrush="#DDD" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Title" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="TitleBox" Margin="0,0,0,12"/>

                <TextBlock Text="Category" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="CategoryBox" Margin="0,0,0,12"/>

                <TextBlock Text="Body" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox x:Name="BodyBox" AcceptsReturn="True" Height="120" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <WrapPanel Margin="0,0,0,12" VerticalAlignment="Center">
                    <StackPanel Width="220">
                        <TextBlock Text="Publish Date" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <DatePicker x:Name="PublishDatePicker" SelectedDate="{x:Static sys:DateTime.Now}" />
                    </StackPanel>

                    <StackPanel Width="220" Margin="16,0,0,0">
                        <TextBlock Text="Expiry Date (optional)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <DatePicker x:Name="ExpiryDatePicker" />
                    </StackPanel>

                    <StackPanel Width="200" Margin="16,0,0,0">
                        <TextBlock Text="Author" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="AuthorBox" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Style="{StaticResource ActionButtonStyle}" Click="OnCancel" Margin="0,0,8,0"/>
            <Button Content="Save Announcement" Style="{StaticResource ActionButtonStyle}" Click="OnSave" />
        </StackPanel>
    </Grid>
</Page>
