<Page x:Class="MunicipalServicesApp.AnnouncementsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Announcements"
      Background="{StaticResource PageBackgroundBrush}" Height="267" Width="536">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📢 Announcements"
                   Style="{StaticResource PageTitleStyle}"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,12"/>

        <!-- Removed Add button; only Home remains -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,12" HorizontalAlignment="Right">
            <Button Content="🏠 Home"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="OnReturnHome"/>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AnnouncementsList" ItemsSource="{Binding Announcements}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="OnOpenAnnouncement"
                                Tag="{Binding}"
                                Background="White"
                                BorderBrush="#DDD"
                                BorderThickness="1"
                                HorizontalContentAlignment="Left"
                                Padding="12"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Category}" Foreground="#666" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding PublishDate, StringFormat=\{0:yyyy-MM-dd\}}" Foreground="#666"/>
                                    <TextBlock Text="{Binding ExpiryDate, StringFormat= — Expires: {0:yyyy-MM-dd}}" Foreground="#999" Margin="12,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Body}" Foreground="#333" Margin="0,6,0,0" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="3" x:Name="FooterText" Foreground="#555" HorizontalAlignment="Left" Margin="0,12,0,0"/>
    </Grid>
</Page>