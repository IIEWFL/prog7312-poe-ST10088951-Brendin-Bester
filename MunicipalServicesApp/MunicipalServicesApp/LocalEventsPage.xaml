<Page x:Class="MunicipalServicesApp.LocalEventsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Local Events"
      Background="{StaticResource PageBackgroundBrush}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Page Title -->
        <TextBlock Text="🏛 Local Events"
                   Style="{StaticResource PageTitleStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12"/>

        <!-- Filters and Controls -->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    Margin="0,6,0,12"
                    VerticalAlignment="Center">
            <ComboBox x:Name="CategoryFilter" Width="160" SelectionChanged="OnFilterChanged" Margin="0,0,8,0"/>
            <DatePicker x:Name="DateFilter" Width="140" SelectedDateChanged="OnFilterChanged" Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox" Width="220" TextChanged="OnSearchChanged" ToolTip="Search title or location..." Margin="0,0,8,0"/>
            <ComboBox x:Name="SortBox" Width="140" SelectionChanged="OnSortChanged" Margin="0,0,8,0">
                <ComboBoxItem Content="Date (Newest)" Tag="date_desc" IsSelected="True"/>
                <ComboBoxItem Content="Date (Oldest)" Tag="date_asc"/>
                <ComboBoxItem Content="Category" Tag="category"/>
                <ComboBoxItem Content="Title" Tag="title"/>
            </ComboBox>

            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#555" Margin="8,0,0,0"/>
            <Button Content="➕ Add Event" Style="{StaticResource ActionButtonStyle}" Click="OnAddSamples" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Events Grid -->
        <DataGrid Grid.Row="2"
                  x:Name="EventsGrid"
                  ItemsSource="{Binding EventsView}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  RowHeight="88"
                  Margin="0,4,0,8"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Image" Width="90" MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#DDD" BorderThickness="1" Margin="6">
                                <Image Source="{Binding ImagePath}" Width="64" Height="64" Stretch="UniformToFill"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Reduced Title width and allow text trimming -->
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="220" MinWidth="140">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" MinWidth="90"/>
                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=\{0:yyyy-MM-dd\}}" Width="110" MinWidth="90"/>
                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*" MinWidth="120"/>

                <!-- Fixed/wider Actions column so buttons are always visible -->
                <DataGridTemplateColumn Header="Actions" Width="160" MinWidth="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0">
                                <Button Content="View"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="OnViewEvent"
                                        Tag="{Binding}"
                                        MinWidth="64"
                                        Padding="6,4"
                                        Margin="0,0,8,0"/>
                                <Button Content="Delete"
                                        Click="OnDeleteEvent"
                                        Tag="{Binding}"
                                        MinWidth="72"
                                        Padding="6,4"
                                        Background="#D9534F"
                                        Foreground="White"
                                        BorderBrush="#B03A2E"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Recommendations -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="6"
                Padding="12"
                BorderBrush="#DDD"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Recommended for you" FontWeight="Bold" Margin="0,0,0,6"/>
                <ItemsControl ItemsSource="{Binding Recommendations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <Image Source="{Binding ImagePath}" Width="40" Height="40" Stretch="UniformToFill" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Date, StringFormat=\{0:yyyy-MM-dd\}}" Foreground="#666" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Category}" Foreground="#777"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Return to Home Page Button -->
        <Button Grid.Row="4"
                Content="🏠 Return to Home Page"
                Style="{StaticResource ActionButtonStyle}"
                Click="OnReturnHome"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"
                Width="232"/>
    </Grid>
</Page>