<Page x:Class="MunicipalServicesApp.ReportIssuesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Report Issues"
      Background="{StaticResource PageBackgroundBrush}">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Title -->
        <TextBlock Text="🛠 Report an Issue"
                   Style="{StaticResource PageTitleStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Form Section -->
        <Border Grid.Row="1"
                Background="White"
                Padding="30"
                CornerRadius="8"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                Effect="{DynamicResource ShadowEffect}">

            <StackPanel>
                <!-- Location -->
                <TextBlock Text="📍 Location:"
                           Style="{StaticResource LabelStyle}"/>
                <TextBox x:Name="LocationBox"
                         Style="{StaticResource InputStyle}"
                         TextChanged="OnInputChanged"/>

                <!-- Category -->
                <TextBlock Text="📂 Category:"
                           Style="{StaticResource LabelStyle}"/>
                <ComboBox x:Name="CategoryBox"
                          Style="{StaticResource InputStyle}"
                          SelectionChanged="OnInputChanged">
                    <ComboBoxItem Content="Sanitation"/>
                    <ComboBoxItem Content="Roads"/>
                    <ComboBoxItem Content="Utilities"/>
                </ComboBox>

                <!-- Description -->
                <TextBlock Text="📝 Description:"
                           Style="{StaticResource LabelStyle}"/>
                <RichTextBox x:Name="DescriptionBox"
                             Style="{StaticResource InputStyle}"
                             Height="100"
                             TextChanged="OnInputChanged"/>

                <!-- Attach Media -->
                <Button x:Name="AttachButton"
                        Content="📎 Attach Media"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="OnAttachMedia"/>

                <!-- Progress Bar -->
                <TextBlock Text="Progress:"
                           Style="{StaticResource LabelStyle}"/>
                <ProgressBar x:Name="ProgressBar"
                             Style="{StaticResource ProgressBarStyle}"
                             Minimum="0" Maximum="100"
                             Value="{Binding ProgressValue}"
                             Margin="0,4,0,12"/>

                <!-- Engagement Message -->
                <TextBlock x:Name="EngagementText"
                           Text="{Binding EngagementMessage}"
                           Style="{StaticResource LabelStyle}"
                           FontStyle="Italic"
                           Foreground="#555"/>

                <!-- Submit -->
                <Button x:Name="SubmitButton"
                        Content="✅ Submit"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="OnSubmit"
                        Margin="0,10,0,0"/>

                <!-- Navigation -->
                <Button Content="⬅ Back to Main Menu"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="OnBack"
                        Margin="0,20,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>