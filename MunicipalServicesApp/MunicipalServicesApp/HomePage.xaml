<Page x:Class="MunicipalServicesApp.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Municipal Services"
      Background="{StaticResource PageBackgroundBrush}" Height="326">

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#002147" Padding="20" CornerRadius="6">
            <TextBlock Text="Municipal Services App"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Subheading -->
        <TextBlock Grid.Row="1"
                   Text="Welcome to your local government portal. Select a service below:"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#333"
                   Margin="0,20,0,10"
                   HorizontalAlignment="Center"/>

        <!-- Service Buttons -->
        <Grid Grid.Row="2" Margin="0,10,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Row 1 -->
            <Button Grid.Row="0" Grid.Column="0"
                    Content="🛠 Report Issues"
                    Style="{StaticResource CardButtonStyle}"
                    Click="OnReportIssues"
                    Margin="8"/>
            <Button Grid.Row="0" Grid.Column="1"
                    Content="📢 Announcements"
                    Style="{StaticResource CardButtonStyle}"
                    Click="OnAnnouncements"
                    Margin="8"/>
            <Button Grid.Row="0" Grid.Column="2"
                    Content="📋 Service Requests"
                    Style="{StaticResource CardButtonStyle}"
                    Click="OnServiceRequests"
                    Margin="8"/>

            <!-- Row 2 -->
            <Button Grid.Row="1" Grid.Column="0"
                    Content="📄 View Reported Issues"
                    Style="{StaticResource CardButtonStyle}"
                    Click="OnViewReportedIssues"
                    Margin="8"/>
            <Button Grid.Row="1" Grid.Column="1"
                    Content="📝 Add Announcement"
                    Style="{StaticResource CardButtonStyle}"
                    Click="OnAddAnnouncement"
                    Margin="8"/>
            <Button Grid.Row="1" Grid.Column="2"
                    Content="🎉 Local Events"
                    Style="{StaticResource CardButtonStyle}"
                    Click="OnLocalEvents"
                    Margin="8"/>
        </Grid>

        <!-- Footer or future content -->
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,10,0,0">
            <!-- Optional footer or status message -->
        </StackPanel>
    </Grid>
</Page>