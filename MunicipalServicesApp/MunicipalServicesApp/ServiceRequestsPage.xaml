<Page x:Class="MunicipalServicesApp.ServiceRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Service Requests"
      Background="{StaticResource PageBackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Service Requests" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,12">
            <TextBox x:Name="SearchBox" Width="360" ToolTip="Search title, location or paste GUID" Margin="0,0,8,0" TextChanged="OnSearchChanged"/>
            <Button Content="Find by ID" Click="OnFindById" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="Add Request" Click="OnAddRequest" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="Refresh" Click="OnRefresh" Style="{StaticResource ActionButtonStyle}"/>
        </StackPanel>

        <DataGrid x:Name="RequestsGrid" Grid.Row="2" AutoGenerateColumns="False" RowHeight="72" IsReadOnly="True" ItemsSource="{Binding DisplayRequests}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="220"/>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="200"/>
                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="140"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="70"/>
                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="140"/>
                <DataGridTemplateColumn Header="Actions" Width="160">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="View" Click="OnView" Tag="{Binding Id}" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"/>
                                <Button Content="Delete" Click="OnDelete" Tag="{Binding Id}" Background="#D9534F" Foreground="White" BorderBrush="#B03A2E"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="White" Padding="12" CornerRadius="6" BorderBrush="#DDD" BorderThickness="1" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Related / Graph / Priority" FontWeight="Bold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Content="Top 3 Priority" Click="OnTopPriority" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="Show MST (Prim)" Click="OnShowMst" Style="{StaticResource ActionButtonStyle}" Margin="0,0,8,0"/>
                    <Button Content="Show Neighbors" Click="OnShowNeighbors" Style="{StaticResource ActionButtonStyle}"/>
                </StackPanel>
                <ListBox x:Name="GraphList" Height="120"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>